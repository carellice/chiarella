<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Chiarella.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Chiarella.Ui"
    Title="Chiarella">

    <Grid x:Name="Root" KeyDown="Root_KeyDown">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#080B19" Offset="0" />
                <GradientStop Color="#0D1030" Offset="0.5" />
                <GradientStop Color="#05070F" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Sfondo vivo: bagliori che prendono il colore dei suoni attivi, più le stelle. -->
        <Canvas x:Name="AuroraLayer" IsHitTestVisible="False" />

        <!-- Barra del titolo personalizzata -->
        <Grid x:Name="TitleBar" Height="40" VerticalAlignment="Top" Padding="16,0,0,0" Canvas.ZIndex="10">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="Assets/chiarella.ico" Width="18" Height="18" />
                <TextBlock Text="Chiarella" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Home -->
        <ScrollViewer x:Name="HomeView" Margin="0,40,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1100" Padding="32,12,32,140">
                <Grid x:Name="Header">
                    <StackPanel>
                        <TextBlock x:Name="Greeting" Text="BUONASERA" Style="{StaticResource OverlineText}" />
                        <TextBlock Text="Trova la tua quiete" FontSize="40" FontWeight="SemiBold" CharacterSpacing="-20" Margin="0,4,0,8"
                                   Foreground="{StaticResource TextBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ui:Equalizer x:Name="StatusEq" Width="18" Height="14" Visibility="Collapsed" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" FontSize="16" Foreground="{StaticResource MutedBrush}"
                                       Text="Accendi uno o più suoni e mescolali come preferisci." />
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="HelpButton" Style="{StaticResource RoundButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                            ToolTipService.ToolTip="Come funziona" AutomationProperties.Name="Come funziona" Click="HelpButton_Click">
                        <FontIcon Glyph="&#xE897;" FontSize="16" />
                    </Button>
                </Grid>

                <Button x:Name="RelaxCard" AutomationProperties.Name="Un momento per te" Margin="0,22,0,0" Padding="16" CornerRadius="26" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
                        Click="RelaxCard_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#4D8B7CF6" Offset="0" />
                            <GradientStop Color="#265EC8F2" Offset="0.55" />
                            <GradientStop Color="#0AFFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Button.Background>
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="RelaxBadge" Width="48" Height="48" CornerRadius="24" Background="{StaticResource AccentGradient}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="RelaxBadgeScale" /></Border.RenderTransform>
                            <TextBlock Text="🧘" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Un momento per te" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="Respira un minuto, poi ti dico cosa fare per rilassarti" FontSize="13"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE72A;" FontSize="16" Foreground="{StaticResource MutedBrush}" />
                    </Grid>
                </Button>

                <Grid x:Name="PresetsTitle" Margin="0,28,0,12">
                    <TextBlock Text="Profili" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock x:Name="PresetsHint" Text="I tuoi mix preferiti" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource FaintBrush}" />
                </Grid>
                <ScrollViewer x:Name="PresetsScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                    <StackPanel x:Name="PresetsPanel" Orientation="Horizontal" Spacing="12" Padding="0,6,0,14" />
                </ScrollViewer>

                <Grid x:Name="SoundsTitle" Margin="0,20,0,12">
                    <TextBlock Text="Suoni" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <HyperlinkButton x:Name="SoundsHint" Content="Tocca per accendere" HorizontalAlignment="Right" IsEnabled="False"
                                     Foreground="{StaticResource FaintBrush}" Click="StopAll_Click" />
                </Grid>
                <ui:UniformWrapPanel x:Name="SoundsPanel" MinItemWidth="230" ItemHeight="210" Spacing="12" />
            </StackPanel>
        </ScrollViewer>

        <!-- Barra del player -->
        <Border x:Name="PlayerBar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="14,0,14,16" MaxWidth="720"
                CornerRadius="30" Padding="14,10,12,10" Background="#D9161B33" BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1" Visibility="Collapsed">
            <Border.RenderTransform><TranslateTransform x:Name="PlayerShift" /></Border.RenderTransform>
            <Grid ColumnSpacing="10" MinWidth="520">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="PlayerStack" Orientation="Horizontal" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="PlayerTitle" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="PlayerSub" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Button x:Name="TimerButton" Style="{StaticResource RoundButton}" ToolTipService.ToolTip="Timer di spegnimento"
                            AutomationProperties.Name="Timer di spegnimento" Click="TimerButton_Click">
                        <FontIcon Glyph="&#xE916;" FontSize="16" />
                    </Button>
                    <Border x:Name="TimerBadge" Background="{StaticResource PeachBrush}" CornerRadius="8" Padding="5,1"
                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="-20,-12,-20,0" IsHitTestVisible="False"
                            Visibility="Collapsed">
                        <TextBlock x:Name="TimerBadgeText" FontSize="10" FontWeight="Bold" Foreground="#1B1B2F" />
                    </Border>
                </Grid>
                <Button Grid.Column="3" x:Name="PlayButton" Width="52" Height="52" CornerRadius="26" Padding="0" BorderThickness="0"
                        Background="{StaticResource AccentGradient}" Foreground="White" Click="PlayButton_Click"
                        ToolTipService.ToolTip="Riproduci / pausa (Spazio)" AutomationProperties.Name="Riproduci / pausa (Spazio)">
                    <FontIcon x:Name="PlayIcon" Glyph="&#xE769;" FontSize="20" />
                </Button>
                <Button Grid.Column="4" Style="{StaticResource RoundButton}" ToolTipService.ToolTip="Ferma tutti" AutomationProperties.Name="Ferma tutti" Click="StopAll_Click">
                    <FontIcon Glyph="&#xE71A;" FontSize="14" />
                </Button>
            </Grid>
        </Border>

        <!-- Un momento per te -->
        <ui:RelaxView x:Name="Relax" Margin="0,40,0,0" Visibility="Collapsed" />
    </Grid>
</Window>
